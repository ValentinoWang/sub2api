# Membership fulfillment overlay. Keep this file outside source control after
# filling secrets; it is consumed together with deploy/.env by Docker Compose.
# Do not put real keys, session material, CDKs, or an upstream vendor URL here.

# The feature and customer checkout both start disabled. Enable each only after
# the validation and production-evidence gates in docs/MEMBERSHIP_FULFILLMENT.md.
MEMBERSHIP_ENABLED=false
MEMBERSHIP_PAYMENTS_ENABLED=false

# This is a dedicated, non-persistent Redis instance. It must not share the
# application Redis database or a volume. The Compose overlay supplies this
# private hostname and disables both RDB snapshots and AOF.
MEMBERSHIP_CREDENTIAL_REDIS_URL=redis://membership-credential-redis:6379/0

# Key material is injected by the deployment secret store, never committed.
# MEMBERSHIP_KEYRING_JSON is a JSON object: {"key-id":"base64-32-byte-key"}.
# MEMBERSHIP_ACTIVE_KEY_ID selects a member of that object.
# MEMBERSHIP_IDENTITY_KEY is a separate base64-encoded 32-byte HMAC key.
MEMBERSHIP_KEYRING_JSON=
MEMBERSHIP_ACTIVE_KEY_ID=
MEMBERSHIP_IDENTITY_KEY=

# The browser agent shares the Sub2API network namespace and binds only its
# loopback listener. The application therefore uses an allowed loopback HTTP
# URL; it is never published to a host port or another Compose network.
MEMBERSHIP_BROWSER_LISTEN_PORT=18081
MEMBERSHIP_BROWSER_URL=http://127.0.0.1:18081
MEMBERSHIP_BROWSER_BEARER_TOKEN=
MEMBERSHIP_BROWSER_IMAGE=

# Supplier values are intentionally blank. Fill them only from an approved
# supplier contract; no real endpoint belongs in this example or repository.
MEMBERSHIP_BROWSER_ALLOWED_HOSTS=
MEMBERSHIP_BROWSER_GPT_BASE_URL=
MEMBERSHIP_BROWSER_GPTPRO_BASE_URL=

# Real supplier submission requires both values and remains disabled by
# default. The confirmation value must exactly match the configured supplier
# hostname. Enable them only for an authorized validation run with dedicated
# CDK and account evidence; disable them again after that run.
MEMBERSHIP_BROWSER_PRODUCTION_SUBMIT_ENABLED=false
MEMBERSHIP_BROWSER_CONFIRM_SUPPLIER_HOST=

# Use a bucket created with S3 Object Lock enabled. The application writes each
# intent with COMPLIANCE mode and validates it with HeadObject after upload.
# Leave the endpoint blank for the provider's standard S3 endpoint. A custom
# endpoint, if used, must come from the approved storage-provider contract.
MEMBERSHIP_AUDIT_BUCKET=
MEMBERSHIP_AUDIT_REGION=
MEMBERSHIP_AUDIT_ENDPOINT=
MEMBERSHIP_AUDIT_ACCESS_KEY_ID=
MEMBERSHIP_AUDIT_SECRET_ACCESS_KEY=
MEMBERSHIP_AUDIT_USE_PATH_STYLE=false
