{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2api.local/schemas/codex-memory-release-v1.json",
  "type": "object",
  "required": ["schema_version", "version", "tag", "repository", "python_minimum", "assets", "checksums"],
  "properties": {
    "schema_version": { "const": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-.][0-9A-Za-z]+)*$" },
    "tag": { "type": "string", "pattern": "^codex-memory-v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-.][0-9A-Za-z]+)*$" },
    "repository": { "type": "string", "pattern": "^[0-9A-Za-z_.-]+/[0-9A-Za-z_.-]+$" },
    "python_minimum": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "released_at": { "type": ["string", "null"], "format": "date-time" },
    "assets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["platform", "filename", "url", "sha256", "size"],
        "properties": {
          "platform": { "enum": ["macos", "windows", "linux"] },
          "filename": { "type": "string", "pattern": "^codex-memory_[0-9A-Za-z.-]+_(macos|windows|linux)\\.zip$" },
          "url": { "type": "string", "pattern": "^https://github\\.com/.+/releases/download/codex-memory-v.+/.+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "checksums": {
      "type": "object",
      "required": ["filename", "url", "sha256"],
      "properties": {
        "filename": { "const": "codex-memory-checksums.txt" },
        "url": { "type": "string", "pattern": "^https://github\\.com/.+/releases/download/codex-memory-v.+/codex-memory-checksums\\.txt$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
