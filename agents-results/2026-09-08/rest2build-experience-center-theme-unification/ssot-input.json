      "id": "D1",
      "key": "rest2build.experience-center.local-hmr-scope",
      "version": 1,
      "record": "agents-results/2026-09-08/rest2build-experience-center-theme-unification/scope-decision.md",
      "summary": "用户确认针对经验中心、主题统一、中文文案和深色导航编制 SSOT，并限定本轮只做本地 HMR，不同步生产端。"
    }
